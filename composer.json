{
    "name": "noerd/cms",
    "description": "Multi-tenant, multi-language CMS module for the noerd framework: pages with a visual element builder, collections, navigation, forms, articles and languages.",
    "type": "library",
    "version": "v0.5.1",
    "keywords": [
        "laravel",
        "livewire",
        "noerd",
        "cms",
        "multi-tenant",
        "multi-language"
    ],
    "homepage": "https://noerd.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Johannes Brock"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0",
        "noerd/noerd": "^0.17",
        "noerd/media": "^0.8",
        "noerd/communication": "^0.6",
        "symfony/polyfill-mbstring": "^1.32",
        "symfony/yaml": "^7.1 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.6 || ^11.1",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Noerd\\Cms\\": "src/",
            "Noerd\\Cms\\Tests\\": "tests/",
            "Noerd\\Cms\\Database\\Factories\\": "database/factories/",
            "Noerd\\Cms\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "test": "pest --compact",
        "lint": "pint --test"
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Noerd\\Cms\\Providers\\CmsServiceProvider"
            ]
        },
        "noerd": {
            "boundary": {
                "allowed": {
                    "noerd/website": "the provider binds the website PageElementService purely by container KEY (a string, never a class load) as a fallback"
                }
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
