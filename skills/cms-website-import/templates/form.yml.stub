key: '{{ form_key_lowercase_snake }}'
title: '{{ Form title shown in admin UI }}'
description: '{{ One-line description }}'

# Two separate mails (noerd/cms 0.6). Placeholders in every subject and body:
#   {{form_title}}        — value of `title` above
#   {{submission_date}}   — formatted submission date
#   {{field:<name>}}      — value of any submitted field
#
# The NOTIFICATION goes to the form recipients of the CMS settings, else to
# notificationEmail — never to the visitor.
sendEmail: true
notificationEmail: '{{ recipient@example.com }}'
emailSubject: '{{ Email subject — supports {{form_title}} and {{field:name}} }}'
emailBody: |
  <h2>{{form_title}}</h2>
  <p><strong>Name:</strong> {{field:name}}</p>
  <p><strong>Email:</strong> {{field:email}}</p>
  <p><strong>Message:</strong></p>
  <p>{{field:message}}</p>
  <hr>
  <p><small>Submitted on {{submission_date}}</small></p>

# The CONFIRMATION goes to the visitor: the address in confirmationField.
sendConfirmation: true
confirmationField: email
confirmationSubject: 'Thank you for your message'
confirmationBody: |
  <p>Hello {{field:name}},</p>
  <p>thank you for your message. We will get back to you soon.</p>

# Field types: text, email, tel, textarea, select, checkbox, radio, date, file
# `validation` takes Laravel rules. `required: true` and a `required` rule mean
# the same — write one of them. A field that is not required is nullable.
fields:
  - name: name
    label: Name
    type: text
    required: true
    validation:
      - string
      - 'max:255'
    errorMessages:
      required: 'Name is required.'
    placeholder: 'Your full name'

  - name: email
    label: Email
    type: email
    required: true
    validation:
      - email
      - 'max:255'
    errorMessages:
      required: 'Email address is required.'
      email: 'Please enter a valid email address.'
    placeholder: 'you@example.com'

  - name: message
    label: Message
    type: textarea
    required: true
    rows: 4
    validation:
      - string
      - 'max:2000'
    errorMessages:
      required: 'A message is required.'

successMessage: 'Thank you! Your message has been sent.'
submitButtonText: 'Send message'
