{
    "name": "noerd/website",
    "description": "Noerd Website module",
    "type": "library",
    "version": "v0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0",
        "livewire/livewire": "^4.0",
        "noerd/cms": "^0.1",
        "noerd/noerd": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Noerd\\Website\\": "src/",
            "Noerd\\Website\\Tests\\": "tests/",
            "Noerd\\Website\\Database\\Factories\\": "database/factories/",
            "Noerd\\Website\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Noerd\\Website\\Providers\\WebsiteServiceProvider"
            ]
        }
    }
}
